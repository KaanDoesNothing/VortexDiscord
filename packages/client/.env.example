# Copy to .env and fill in. Bun loads .env automatically.

# Bot token: Developer Portal > your app > Bot > Reset Token
DISCORD_TOKEN=

# Postgres connection string (user and password go before the @)
DATABASE_URL=postgres://vortex:password@localhost:5432/vortex

# API server the dashboard talks to
API_PORT=7805
# Public URL of the dashboard (used for the login redirect and CORS)
FRONTEND_URL=http://localhost:7807

# Dashboard login: Developer Portal > your app > OAuth2.
# Add {FRONTEND_URL}/oauth/callback as a redirect there, e.g. http://localhost:7807/oauth/callback
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# Welcome/goodbye messages and auto-roles need the privileged "Server Members" intent.
# Turn it on in Developer Portal > Bot > Privileged Gateway Intents FIRST, then set this to true.
DISCORD_MEMBERS_INTENT=false

# Extra bot owners (comma-separated user IDs). The Discord application owner is always one.
OWNER_IDS=

# Music: a NodeLink server (https://github.com/PerformanC/NodeLink). Lavalink v4 also works
# (set NODELINK_TYPE=lavalink). Leave NODELINK_HOST empty to turn music off.
NODELINK_HOST=
NODELINK_TYPE=nodelink
NODELINK_PORT=3000
NODELINK_PASSWORD=
NODELINK_SECURE=false

# ---------- Optional: growth & integrations ----------

# Link shown on /invite, /help, /feedback and the "thanks for adding me" message.
SUPPORT_SERVER_URL=
# Channel (ID) where /feedback reports are posted.
FEEDBACK_CHANNEL_ID=

# Bot lists: server counts are posted every 30 minutes so the bot ranks there.
TOPGG_TOKEN=
DBL_TOKEN=
# top.gg vote rewards: set top.gg's webhook URL to <API URL>/webhooks/topgg and its
# Authorization to this same secret. Voters get VOTE_REWARD coins (double on weekends).
TOPGG_WEBHOOK_SECRET=
VOTE_REWARD=2500

# Twitch "went live" feeds: https://dev.twitch.tv/console/apps (Client ID + a new secret).
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
